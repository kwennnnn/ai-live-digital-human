{
  "vidu": {
    "env": "cn",
    "api_key_file": "~/.deepsea/vidu/api.key",
    "model": "vidu-s2",
    "call_mode": "video",
    "rtc_provider": "artc",
    "max_tokens": 80,
    "enable_recording": true,
    "credit_price_rmb": 0.03125,
    "credits_per_second": 1.5
  },
  "avatar_profile": "xiaoshen",
  "avatars": {
    "xiaoshen": {
      "name": "小深",
      "image": "assets/avatars/xiaoshen.jpg",
      "voice": "",
      "persona_file": "persona.md",
      "greeting_instruction": "用一句话热情地跟直播间观众打招呼，告诉大家可以发弹幕指挥你换衣服、换背景、拿东西"
    }
  },
  "schedule": {
    "interval_seconds": 20,
    "policy": "random_recent",
    "max_age_seconds": 180,
    "max_queue": 200,
    "idle_prompt_after_seconds": 45,
    "interrupt_policy": "gift"
  },
  "safety": {
    "max_session_minutes": 30,
    "budget_credits": 3000,
    "live_visual_edits": true,
    "visual_edit_cooldown_seconds": 20,
    "visual_edit_max_consecutive": 2,
    "visual_edit_single_change_only": true,
    "visual_edit_bundle_outfit": true
  },
  "generator": {
    "enabled": true,
    "api_key_file": "~/.deepsea/evolink/api.key",
    "model": "gpt-image-2.5-sunburst",
    "resolution": "1K",
    "quality": "medium",
    "timeout_seconds": 180
  },
  "server": {
    "host": "127.0.0.1",
    "port": 28900
  },
  "show": {
    "kpi_target": 0,
    "kpi_name": "本场营业目标",
    "vote_duration_seconds": 60
  },
  "products": []
}
